<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="4dp">
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_folder_plain" android:contentDescription="@null" app:tint="@color/brand" />
    <TextView android:id="@+id/header" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="?android:attr/textColorPrimary" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="middle" />
    <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" />
</LinearLayout>
